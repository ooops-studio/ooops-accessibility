---
import AccessibilityHead from '@ooopsstudio/accessibility-astro/AccessibilityHead.astro'
import AccessibilityMenu from '@ooopsstudio/accessibility-astro/AccessibilityMenu.astro'
import SkipLink from '@ooopsstudio/accessibility-astro/SkipLink.astro'
import type {AccessibilityLocale} from '@ooopsstudio/accessibility'
import type {AccessibilityPosition} from '@ooopsstudio/accessibility-astro'

type Props = {
	page: string
	locale?: AccessibilityLocale
	position?: AccessibilityPosition
	enabled?: boolean
	custom?: boolean
	switchTarget?: string
	switchLabel?: string
	menuStyle?: string
}

const {
	page,
	locale = 'en',
	position = 'bottom-right',
	enabled = true,
	custom = false,
	switchTarget,
	switchLabel,
	menuStyle
} = Astro.props

const copy = locale === 'el'
	? {
		title: 'Δοκιμή προσβασιμότητας',
		description: 'Πραγματική εφαρμογή Astro που εγκαθιστά τα πακέτα από tarball.',
		focus: 'Κύρια ενέργεια'
	}
	: {
		title: 'Accessibility test page',
		description: 'Real Astro application installing the packages from tarballs.',
		focus: 'Primary action'
	}
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{copy.title} · Astro</title>
		<AccessibilityHead {enabled} />
	</head>
	<body>
		<SkipLink {locale} href="#main-content" />
		<main id="main-content" tabindex="-1" data-consumer="astro" data-page={page}>
			<p class="adapter-label">Astro packed consumer</p>
			<h1>{copy.title}</h1>
			<p>{copy.description}</p>
			<button type="button" class="primary-action">{copy.focus}</button>
			{switchTarget && switchLabel && (
				<button type="button" class="host-switch" data-switch-target={switchTarget}>{switchLabel}</button>
			)}

			{custom ? (
				<AccessibilityMenu
					{enabled}
					{locale}
					{position}
					includeBaseStyles={false}
					includeGlobalEffects={false}
					labels={{open: 'Open custom accessibility menu'}}
					classNames={{widget: 'fixture-custom-widget', trigger: 'fixture-custom-trigger', panel: 'fixture-custom-panel'}}
				>
					<span slot="trigger" aria-hidden="true">A11Y Custom</span>
					<div slot="menu" class="fixture-custom-menu">
						<h2>Custom accessibility menu</h2>
						<button type="button" data-ooops-a11y-toggle="highContrast" aria-pressed="false">Custom contrast</button>
						<button type="button" data-ooops-a11y-reset>Custom reset</button>
						<button type="button" data-ooops-a11y-close>Custom close</button>
					</div>
				</AccessibilityMenu>
			) : (
				<AccessibilityMenu
					{enabled}
					{locale}
					{position}
					style={menuStyle}
					includeGlobalEffects={false}
					classNames={{
						triggerIcon: 'fixture-trigger-icon',
						controlTitle: 'fixture-control-title',
						rangeButton: 'fixture-range-button',
						iconWrap: 'fixture-icon-wrap',
						controlIcon: 'fixture-control-icon',
						toggleLabel: 'fixture-toggle-label'
					}}
				/>
			)}
		</main>
	</body>
</html>

<style is:global>
	:root {
		--color-bg: #f4f7fb;
		--color-surface: #ffffff;
		--color-surface-raised: #ffffff;
		--color-text: #172033;
		--color-border: #69758c;
		--color-accent: #075ec8;
		--color-accent-contrast: #ffffff;
		--color-focus-ring: #ffb000;
	}

	* { box-sizing: border-box; }
	body {
		min-width: 320px;
		min-height: 100vh;
		margin: 0;
		background: var(--color-bg);
		color: var(--color-text);
		font-family: system-ui, sans-serif;
	}
	main {
		width: min(46rem, calc(100% - 3rem));
		margin-inline: auto;
		padding-block: 5rem;
	}
	.adapter-label {
		color: var(--color-accent);
		font-size: .78rem;
		font-weight: 800;
		letter-spacing: .08em;
		text-transform: uppercase;
	}
	h1 { max-width: 18ch; margin-block: .5rem 1rem; font-size: clamp(2rem, 6vw, 4rem); line-height: 1; }
	main > p:not(.adapter-label) { max-width: 42rem; font-size: 1.05rem; }
	.primary-action,
	.host-switch {
		min-height: 44px;
		margin: 1rem .5rem 0 0;
		padding: .65rem 1rem;
		border: 2px solid var(--color-accent);
		border-radius: .75rem;
		background: var(--color-accent);
		color: var(--color-accent-contrast);
		font: inherit;
		font-weight: 750;
	}

	.fixture-custom-widget { margin-top: 2rem; }
	.fixture-custom-trigger {
		min-height: 48px;
		padding: .7rem 1rem;
		border: 2px solid #5420a8;
		border-radius: .7rem;
		background: #6e35c7;
		color: #fff;
		font: inherit;
		font-weight: 850;
	}
	.fixture-custom-panel {
		position: absolute;
		top: calc(100% + .75rem);
		left: 0;
		z-index: 1001;
		width: min(24rem, calc(100vw - 2rem));
		padding: 1rem;
		border: 3px solid #5420a8;
		border-radius: 1rem;
		background: #fff;
		box-shadow: 0 1rem 3rem rgb(32 14 61 / 22%);
	}
	.fixture-custom-menu { display: grid; gap: .75rem; }
	.fixture-custom-menu h2 { margin: 0; }
	.fixture-custom-menu button {
		min-height: 44px;
		border: 2px solid #5420a8;
		border-radius: .6rem;
		background: #fff;
		color: #341568;
		font: inherit;
		font-weight: 750;
	}
	.fixture-custom-menu button[aria-pressed="true"] { background: #5420a8; color: #fff; }

	@media (max-width: 640px) {
		main { width: min(100% - 2rem, 46rem); padding-block: 3rem; }
		h1 { font-size: 2.35rem; }
	}
</style>

<script>
	document.addEventListener('click', (event) => {
		const trigger = event.target instanceof Element
			? event.target.closest<HTMLElement>('[data-switch-target]')
			: null
		if (trigger?.dataset.switchTarget) window.location.assign(trigger.dataset.switchTarget)
	})
</script>
