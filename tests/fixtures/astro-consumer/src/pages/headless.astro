---
import AccessibilityHead from '@ooopsstudio/accessibility-astro/AccessibilityHead.astro'
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Headless accessibility settings · Astro</title>
		<AccessibilityHead storageKey="ooops.accessibility.headless.astro" />
	</head>
	<body>
		<main>
			<p class="adapter-label">Astro packed consumer</p>
			<h1>Account settings</h1>
			<aside class="settings-sidebar" aria-labelledby="accessibility-settings-title" data-headless-settings>
				<h2 id="accessibility-settings-title">Accessibility settings</h2>
				<label class="toggle-row">
					<input type="checkbox" data-headless-contrast />
					High contrast
				</label>
				<label for="headless-font-scale">Font size</label>
				<div class="range-row">
					<input id="headless-font-scale" type="range" min="80" max="200" step="10" value="100" data-headless-scale />
					<output for="headless-font-scale" data-headless-value>100%</output>
				</div>
				<button type="button" data-headless-reset>Reset settings</button>
			</aside>
		</main>
	</body>
</html>

<style>
	:global(*) { box-sizing: border-box; }
	:global(body) { min-height: 100vh; margin: 0; background: #f4f7fb; color: #172033; font-family: system-ui, sans-serif; }
	main { width: min(58rem, calc(100% - 2rem)); margin-inline: auto; padding-block: 4rem; }
	.adapter-label { color: #075ec8; font-size: .78rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
	h1 { margin-block: .5rem 2rem; font-size: clamp(2rem, 6vw, 4rem); line-height: 1; }
	.settings-sidebar { width: min(100%, 22rem); padding: 1.25rem; border: 2px solid #172033; border-radius: .75rem; background: #fff; box-shadow: .5rem .5rem 0 #b8d4f5; }
	.settings-sidebar h2 { margin-block: 0 1.25rem; font-size: 1.35rem; }
	.settings-sidebar label:not(.toggle-row) { display: block; margin-block: 1.25rem .5rem; font-weight: 700; }
	.toggle-row { display: flex; align-items: center; gap: .65rem; }
	.range-row { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: .75rem; }
	.settings-sidebar button { min-height: 44px; margin-top: 1.25rem; padding-inline: 1rem; border: 0; border-radius: .45rem; background: #075ec8; color: #fff; font: inherit; font-weight: 700; }
</style>

<script>
	import {createAccessibilityController} from '@ooopsstudio/accessibility'

	const container = document.querySelector('[data-headless-settings]')
	const contrast = container?.querySelector('[data-headless-contrast]')
	const scale = container?.querySelector('[data-headless-scale]')
	const value = container?.querySelector('[data-headless-value]')
	const reset = container?.querySelector('[data-headless-reset]')

	if (container instanceof HTMLElement
		&& contrast instanceof HTMLInputElement
		&& scale instanceof HTMLInputElement
		&& value instanceof HTMLOutputElement
		&& reset instanceof HTMLButtonElement) {
		const controller = createAccessibilityController({storageKey: 'ooops.accessibility.headless.astro'})
		const render = (preferences) => {
			contrast.checked = preferences.highContrast
			scale.value = String(preferences.fontScale)
			value.value = `${preferences.fontScale}%`
		}
		contrast.addEventListener('change', () => controller.setPreference('highContrast', contrast.checked))
		scale.addEventListener('input', () => controller.setPreference('fontScale', Number(scale.value)))
		reset.addEventListener('click', () => controller.reset())
		const unsubscribe = controller.subscribe(render)
		render(controller.getPreferences())
		container.dataset.ready = 'true'
		window.addEventListener('pagehide', () => {
			unsubscribe()
			controller.destroy()
		}, {once: true})
	}
</script>
