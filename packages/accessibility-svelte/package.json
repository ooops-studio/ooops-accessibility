{
  "name": "@ooopsstudio/accessibility-svelte",
  "version": "0.2.1",
  "private": false,
  "type": "module",
  "description": "Svelte 5 components for @ooopsstudio/accessibility.",
  "license": "MIT",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./AccessibilityMenu.svelte": {
      "types": "./dist/AccessibilityMenu.svelte.d.ts",
      "svelte": "./dist/AccessibilityMenu.svelte",
      "default": "./dist/AccessibilityMenu.svelte"
    },
    "./AccessibilityHead.svelte": {
      "types": "./dist/AccessibilityHead.svelte.d.ts",
      "svelte": "./dist/AccessibilityHead.svelte",
      "default": "./dist/AccessibilityHead.svelte"
    },
    "./SkipLink.svelte": {
      "types": "./dist/SkipLink.svelte.d.ts",
      "svelte": "./dist/SkipLink.svelte",
      "default": "./dist/SkipLink.svelte"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "svelte-package && node ./scripts/finalize-package.mjs",
    "test": "vitest run --config vitest.config.ts",
    "pack:dry": "pnpm build && npm pack --dry-run",
    "typecheck": "svelte-package --types false",
    "size": "node ./scripts/check-size.mjs",
    "publint": "publint",
    "attw": "attw --pack --ignore-rules no-resolution --ignore-rules cjs-resolves-to-esm",
    "depcruise": "pnpm -w exec dependency-cruise --config .dependency-cruiser.cjs packages/accessibility-svelte/src"
  },
  "dependencies": {
    "@ooopsstudio/accessibility": "workspace:^",
    "@ooopsstudio/ui-svelte": "^0.1.1"
  },
  "peerDependencies": {
    "svelte": ">=5 <6"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@testing-library/svelte": "^5.2.9",
    "jsdom": "^27.4.0",
    "svelte": "^5.56.4",
    "typescript": "5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ooops-studio/ooops-accessibility.git",
    "directory": "packages/accessibility-svelte"
  },
  "homepage": "https://github.com/ooops-studio/ooops-accessibility/tree/main/packages/accessibility-svelte#readme",
  "bugs": {
    "url": "https://github.com/ooops-studio/ooops-accessibility/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
