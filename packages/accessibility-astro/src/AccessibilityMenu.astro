---
import {
	ACCESSIBILITY_TRIGGER_ICON,
	DEFAULT_ACCESSIBILITY_STORAGE_KEY,
	getAccessibilityIconDefinition,
	getAccessibilityControls,
	getAccessibilityLabels
} from '@ooopsstudio/accessibility'
import Part from '@ooopsstudio/ui-astro/Part.astro'
import AccessibilityIcon from './AccessibilityIcon.astro'
import {
	accessibilityGlobalStyles,
	accessibilityMenuStyles,
	serializeInlineJson
} from './index'
import type {AccessibilityLabels, AccessibilityMenuProps} from './index'

const {
	enabled = true,
	label,
	position = 'bottom-right',
	storageKey = DEFAULT_ACCESSIBILITY_STORAGE_KEY,
	class: className = '',
	panelId = 'ooops-accessibility-panel',
	controls: suppliedControls,
	locale = 'en',
	labels,
	classNames = {},
	style,
	includeBaseStyles = true,
	includeGlobalEffects = true
} = Astro.props as AccessibilityMenuProps

const localizedLabels = getAccessibilityLabels(locale)
const resolvedLabels: AccessibilityLabels = {
	...localizedLabels,
	...labels,
	title: label ?? labels?.title ?? localizedLabels.title
}
const controls = suppliedControls ?? getAccessibilityControls(locale)

const config = serializeInlineJson({
	storageKey,
	labels: resolvedLabels
})
---

{enabled && (
	<div
		class:list={[
			'ooops-a11y-widget',
			`ooops-a11y-widget-${position}`,
			className,
			classNames.widget
		]}
		style={style}
		lang={locale}
		data-ooops-a11y-widget
		data-part="root"
	>
		<script type="application/json" data-ooops-a11y-config set:html={config} />
		<button
			type="button"
			class:list={['ooops-a11y-trigger', classNames.trigger]}
			aria-controls={panelId}
			aria-expanded="false"
			data-ooops-a11y-trigger
			data-part="trigger"
		>
			<span class:list={['sr-only', classNames.triggerLabel]} data-part="trigger-label">{resolvedLabels.open}</span>
			<slot name="trigger">
				<AccessibilityIcon
					icon={ACCESSIBILITY_TRIGGER_ICON}
					class={['ooops-a11y-trigger-icon', classNames.triggerIcon].filter(Boolean).join(' ')}
					dataPart="trigger-icon"
				/>
			</slot>
		</button>
		<div class:list={['ooops-a11y-overlay', classNames.overlay]} hidden data-ooops-a11y-overlay data-part="overlay"></div>
		<section
			id={panelId}
			class:list={['ooops-a11y-panel', classNames.panel]}
			role="dialog"
			aria-modal="true"
			aria-label={resolvedLabels.title}
			hidden
			data-ooops-a11y-panel
			data-part="content"
		>
			<slot name="menu">
			<Part part="header" as="header" class={`ooops-a11y-header ${classNames.header ?? ''}`.trim()}>
				<slot name="header">
				<div class:list={['ooops-a11y-header-content', classNames.headerContent]} data-part="header-content">
					<span class:list={['ooops-a11y-eyebrow', classNames.eyebrow]}>{resolvedLabels.eyebrow}</span>
					<h2 id={`${panelId}-title`} class={classNames.title}>{resolvedLabels.title}</h2>
				</div>
				</slot>
				<div class:list={['ooops-a11y-header-actions', classNames.headerActions]} data-part="header-actions">
					<button type="button" class:list={['ooops-a11y-reset', classNames.reset]} data-ooops-a11y-reset data-part="reset">
						{resolvedLabels.reset}
					</button>
					<button type="button" class:list={['ooops-a11y-close', classNames.close]} data-ooops-a11y-close data-part="close">
						<span class:list={['ooops-a11y-close-icon', classNames.closeIcon]} data-part="close-icon" aria-hidden="true">×</span>
						<span class:list={['sr-only', classNames.closeLabel]} data-part="close-label">{resolvedLabels.close}</span>
					</button>
				</div>
			</Part>
			<slot name="before-controls" />
			<Part part="items" class={`ooops-a11y-grid ${classNames.grid ?? ''}`.trim()}>
				{controls.map((control) => (
					control.type === 'range' ? (
						<Part part="item" class={`ooops-a11y-card ooops-a11y-range ${classNames.item ?? ''} ${classNames.card ?? ''} ${classNames.range ?? ''}`.trim()} data-ooops-a11y-range={control.key}>
							<span class:list={['ooops-a11y-control-title', classNames.controlTitle]} data-part="control-title">{control.label}</span>
							<div class:list={['ooops-a11y-range-controls', classNames.rangeControls]} data-part="range-controls">
								<button
									type="button"
									class:list={['ooops-a11y-range-button', classNames.rangeButton]}
									data-part="range-button"
									data-ooops-a11y-step={control.key}
									data-direction="-1"
									aria-label={`${resolvedLabels.decrease} ${control.label}`}
								>
									−
								</button>
								<span class:list={['ooops-a11y-value', classNames.value]} data-part="value" aria-live="polite" aria-atomic="true" data-ooops-a11y-value={control.key}>100%</span>
								<button
									type="button"
									class:list={['ooops-a11y-range-button', classNames.rangeButton]}
									data-part="range-button"
									data-ooops-a11y-step={control.key}
									data-direction="1"
									aria-label={`${resolvedLabels.increase} ${control.label}`}
								>
									+
								</button>
							</div>
						</Part>
					) : (
						<button
							type="button"
							class:list={['ooops-a11y-card', 'ooops-a11y-toggle', classNames.item, classNames.card, classNames.toggle]}
							aria-pressed="false"
							data-ooops-a11y-toggle={control.key}
						>
							<span class:list={['ooops-a11y-icon-wrap', classNames.iconWrap]} data-part="icon-wrap" aria-hidden="true">
								{control.icon ?? <AccessibilityIcon icon={getAccessibilityIconDefinition(control.key)} class={['ooops-a11y-control-icon', classNames.controlIcon].filter(Boolean).join(' ')} dataPart="control-icon" />}
							</span>
							<span class:list={['ooops-a11y-toggle-label', classNames.toggleLabel]} data-part="toggle-label">{control.label}</span>
						</button>
					)
				))}
			</Part>
			<slot name="after-controls" />
			<slot name="footer" />
			</slot>
		</section>
	</div>
)}

{enabled && includeGlobalEffects && <style is:global set:html={accessibilityGlobalStyles} />}
{enabled && includeBaseStyles && <style is:global set:html={accessibilityMenuStyles} />}

<script>
	import {createAccessibilityController, createFocusTrap, fitAccessibilityPanelToViewport} from '@ooopsstudio/accessibility'

	const initializedWidgets = new WeakSet()
	const widgetCleanups = new Map<HTMLElement, () => void>()

	const readConfig = (widget) => {
		const configNode = widget.querySelector('[data-ooops-a11y-config]')

		if (!(configNode instanceof HTMLScriptElement)) {
			return {}
		}

		try {
			return JSON.parse(configNode.textContent || '{}')
		} catch {
			return {}
		}
	}

	const syncWidget = (widget, preferences) => {
		widget.querySelectorAll('[data-ooops-a11y-toggle]').forEach((button) => {
			if (!(button instanceof HTMLButtonElement)) {
				return
			}

			const key = button.dataset.ooopsA11yToggle
			button.setAttribute('aria-pressed', String(Boolean(preferences[key])))
		})

		widget.querySelectorAll('[data-ooops-a11y-value]').forEach((node) => {
			if (!(node instanceof HTMLElement)) {
				return
			}

			const key = node.dataset.ooopsA11yValue
			const value = preferences[key]
			node.textContent = typeof value === 'number' ? `${value}%` : ''
		})
	}

	const initWidget = (widget) => {
		if (!(widget instanceof HTMLElement) || initializedWidgets.has(widget)) {
			return
		}

		const trigger = widget.querySelector('[data-ooops-a11y-trigger]')
		const panel = widget.querySelector('[data-ooops-a11y-panel]')
		const overlay = widget.querySelector('[data-ooops-a11y-overlay]')
		const closeButton = widget.querySelector('[data-ooops-a11y-close]')
		const resetButton = widget.querySelector('[data-ooops-a11y-reset]')

		if (!(trigger instanceof HTMLButtonElement) || !(panel instanceof HTMLElement)) {
			return
		}

		const config = readConfig(widget)
		const events = new AbortController()
		const {signal} = events
		const controller = createAccessibilityController({
			storageKey: typeof config.storageKey === 'string' ? config.storageKey : undefined
		})
		const focusController = createFocusTrap({
			getContainer: () => panel,
			getRoot: () => widget,
			getInitialFocus: () => closeButton instanceof HTMLElement ? closeButton : null,
			getRestoreFocusTo: () => trigger,
			modal: true,
			onEscape: () => closePanel()
		})

		const openPanel = () => {
			panel.hidden = false
			fitAccessibilityPanelToViewport(panel)
			if (overlay instanceof HTMLElement) {
				overlay.hidden = false
			}
			trigger.setAttribute('aria-expanded', 'true')
			focusController.activate()
		}

		const closePanel = () => {
			focusController.deactivate()
			panel.hidden = true
			if (overlay instanceof HTMLElement) {
				overlay.hidden = true
			}
			trigger.setAttribute('aria-expanded', 'false')
		}

		trigger.addEventListener('click', () => {
			if (panel.hidden) {
				openPanel()
			} else {
				closePanel()
			}
		}, {signal})

		closeButton?.addEventListener('click', closePanel, {signal})
		overlay?.addEventListener('click', closePanel, {signal})
		resetButton?.addEventListener('click', () => controller.reset(), {signal})
		window.addEventListener('resize', () => {
			if (!panel.hidden) {
				fitAccessibilityPanelToViewport(panel)
			}
		}, {signal})

		widget.querySelectorAll('[data-ooops-a11y-toggle]').forEach((button) => {
			button.addEventListener('click', () => {
				if (!(button instanceof HTMLElement)) {
					return
				}

				const key = button.dataset.ooopsA11yToggle
				if (key) {
					controller.toggle(key)
				}
			}, {signal})
		})

		widget.querySelectorAll('[data-ooops-a11y-step]').forEach((button) => {
			button.addEventListener('click', () => {
				if (!(button instanceof HTMLElement)) {
					return
				}

				const key = button.dataset.ooopsA11yStep
				const direction = button.dataset.direction === '-1' ? -1 : 1
				if (key) {
					controller.stepRange(key, direction)
				}
			}, {signal})
		})

		document.addEventListener('pointermove', (event) => {
			if (controller.getPreferences().readingGuide) {
				controller.updateReadingGuide(event.clientY)
			}
		}, {passive: true, signal})

		const unsubscribe = controller.subscribe((preferences) => syncWidget(widget, preferences))
		syncWidget(widget, controller.getPreferences())
		initializedWidgets.add(widget)
		widgetCleanups.set(widget, () => {
			events.abort()
			unsubscribe()
			focusController.destroy()
			controller.destroy()
			initializedWidgets.delete(widget)
			widgetCleanups.delete(widget)
		})
	}

	const initAccessibilityWidgets = () => {
		document.querySelectorAll('[data-ooops-a11y-widget]').forEach(initWidget)
	}

	initAccessibilityWidgets()
	document.addEventListener('astro:page-load', initAccessibilityWidgets)
	document.addEventListener('astro:before-swap', () => {
		for (const cleanup of [...widgetCleanups.values()]) cleanup()
	})
</script>
